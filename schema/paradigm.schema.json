{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/savorcode/bci-paradigm-atlas/schema/paradigm.schema.json",
  "title": "BCI paradigm",
  "description": "One concrete paradigm (protocol) of a paradigm class. Schema 0.2 (draft). See docs/methodology.md §1, §6 and curation/decisions.md D-057.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "class",
    "name",
    "family",
    "bci_category",
    "recording_modality",
    "stimulus_modality",
    "markers",
    "description",
    "first_source",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[A-Z0-9]{2,8}-[0-9]{3}$"
    },
    "class": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[A-Z0-9]{2,8}$",
      "description": "Paradigm class id (<FAMILY>-<SHORT>) registered in paradigms/_classes.yaml; must equal id without the -NNN suffix"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/bilingual"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "family": {
      "type": "string"
    },
    "bci_category": {
      "type": "array",
      "items": {
        "enum": [
          "active",
          "reactive",
          "passive",
          "none"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "recording_modality": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "stimulus_modality": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MK\\.[A-Za-z0-9_]+$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Neural markers elicited, ids from knowledge/markers/"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/bilingual"
    },
    "trial_structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "duration_ms": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "typical_trials": {
          "type": [
            "integer",
            "string"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinguishing"
      ],
      "description": "The task configuration of this concrete paradigm. A change in class/condition set, stimulus or cue type (incl. coding scheme), trial structure or feedback mode gives a new serial number (D-057).",
      "properties": {
        "n_classes": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of distinct classes / targets / conditions decoded or contrasted"
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "The classes / targets / conditions, e.g. [left hand, right hand]"
        },
        "cue": {
          "type": "string",
          "description": "Cue or stimulus type, e.g. visual arrow cue, flickering targets"
        },
        "stimulus_coding": {
          "type": "string",
          "description": "Stimulus coding scheme, e.g. frequency coding, joint frequency-phase coding, row/column flashing, checkerboard"
        },
        "paradigm_timing": {
          "enum": [
            "synchronous",
            "asynchronous",
            "block",
            "continuous"
          ],
          "description": "synchronous = cue-paced trials; asynchronous = self-paced; block = block design; continuous = no trial segmentation"
        },
        "feedback": {
          "enum": [
            "none",
            "discrete",
            "continuous"
          ],
          "description": "none = open loop; discrete = per-trial/selection feedback; continuous = closed-loop continuous feedback"
        },
        "distinguishing": {
          "type": "string",
          "minLength": 1,
          "description": "What distinguishes this protocol from its siblings in the same class, citing numbering criteria 1-4 (class set, stimulus/cue, trial structure, feedback)"
        }
      }
    },
    "first_source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Parameter-level variations only (durations, ISI, trial counts, values within the same coding scheme); configuration changes are separate concrete paradigms (D-057)"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "subjects": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "interop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bids_task": {
          "type": "string"
        },
        "hed_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cognitive_atlas_task": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "contributors": {
      "$ref": "common.schema.json#/$defs/contributors"
    },
    "reviewed_by": {
      "$ref": "common.schema.json#/$defs/contributors"
    }
  }
}