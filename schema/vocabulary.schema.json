{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/savorcode/bci-paradigm-atlas/schema/vocabulary.schema.json",
  "title": "Knowledge vocabulary",
  "description": "List of brain regions or cognitive constructs. Schema 0.2 (optional fields atlas_refs, coordinate_space, sources, notes added in the knowledge-layer update).",
  "type": "object",
  "required": [
    "schema_version",
    "prefix",
    "terms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "prefix": {
      "enum": [
        "BR",
        "CN"
      ]
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "en",
          "zh"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(BR|CN)\\.[A-Za-z0-9_]+$"
          },
          "en": {
            "type": "string"
          },
          "zh": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "includes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cognitive_atlas": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ],
            "description": "Omitted means active. Deprecated ids stay in the file (identifiers are never reused, D-063)."
          },
          "replaced_by": {
            "type": "string",
            "description": "For deprecated terms: the id to use instead."
          },
          "atlas_refs": {
            "type": "object",
            "additionalProperties": false,
            "description": "Regions only: corresponding labels in standard atlases (approximate correspondence).",
            "properties": {
              "brodmann": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "aal3": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hcp_mmp1": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "coordinate_space": {
            "type": "string",
            "description": "Regions only: coordinate space the atlas labels refer to, e.g. MNI152."
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/source"
            },
            "description": "Sources for the definition or the atlas correspondence."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
